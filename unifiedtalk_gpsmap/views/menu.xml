<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_gps_open" model="ir.actions.server">
        <field name="name">GPS Map</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = env['unifiedtalk.gpsmap.account'].action_open()</field>
    </record>
    <menuitem id="menu_gps_root"
              name="GPS Map"
              action="action_gps_open"
              web_icon="unifiedtalk_gpsmap,static/description/icon.png"
              sequence="25"/>
    <menuitem id="menu_gps_users"
              name="Assigned users"
              parent="menu_gps_root"
              action="action_gps_usernames"
              groups="base.group_system"
              sequence="20"/>
</odoo>
