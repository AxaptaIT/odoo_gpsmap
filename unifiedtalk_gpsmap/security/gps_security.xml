<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_gps_map">
        <field name="name">GPS Map</field>
        <field name="sequence">40</field>
    </record>
    <record model="res.groups.privilege" id="privilege_gps_map">
        <field name="name">GPS Map</field>
        <field name="category_id" ref="module_category_gps_map"/>
    </record>
    <record id="group_gps_map" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_gps_map"/>
        <field name="comment">Can open the live GPS map.</field>
    </record>
</odoo>
